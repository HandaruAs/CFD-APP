<?xml version="1.0" encoding="utf-8"?>
<!-- Splash native (tampil sebelum Flutter engine nyala). Logo di
     drawable-<density>/launch_logo.png, di-generate dari
     assets/images/logo.png (di-crop dari padding transparan, lalu
     di-resize per densitas: mdpi 140dp lebar, dst mengikuti skala
     Android baku). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_logo" />
    </item>
</layer-list>
